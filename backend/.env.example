# ── LLM ──────────────────────────────────────────────────────────────────────


# ── Speech ────────────────────────────────────────────────────────────────────
WHISPER_MODEL=whisper-1
TTS_VOICE=alloy

# ── Redis (optional — falls back to in-memory if not set) ────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Database (optional — uses SQLite by default) ─────────────────────────────
DATABASE_URL=sqlite:///./appointments.db
